generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  FIELD_STAFF
  OFFICE_STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  HOLIDAY
  LEAVE
}

enum VisitType {
  SALES
  SERVICE
  SURVEY
  DELIVERY
  OTHER
}

enum VisitStatus {
  COMPLETED
  NO_RESPONSE
  RESCHEDULED
  CANCELLED
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
}

enum ProjectRole {
  LEAD
  MEMBER
}

enum LeaveType {
  SICK
  CASUAL
  EARNED
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  TASK
  ATTENDANCE
  LEAVE
  GEOFENCE 
  SYSTEM
  REPORT
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  ACCOMMODATION
  OTHER
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  territories Territory[]
  projects    Project[]
  tasks       Task[]
  feedbacks   EmployeeFeedback[]
  shifts      Shift[]
}

model User {
  id             String      @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String
  email          String      @unique
  passwordHash   String
  phone          String?
  profileImage   String?
  employeeId     String
  department     String?
  
  role           Role        @default(FIELD_STAFF)
  status         UserStatus  @default(ACTIVE)
  
  managerId      String?
  manager        User?       @relation("ManagerSubordinates", fields: [managerId], references: [id])
  subordinates   User[]      @relation("ManagerSubordinates")
  
  territoryId    String?
  territory      Territory?  @relation(fields: [territoryId], references: [id])
  
  shiftId        String?
  shift          Shift?      @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  
  deviceToken    String?
  lastActiveAt   DateTime?

  // Salary & Allowance (set by Admin)
  baseSalary            Float?   // monthly base salary in INR
  bonus                 Float?   @default(0) // fixed bonus or deduction
  travelAllowanceRate   Float?   @default(4) // ₹ per KM, default ₹4
  profileImageLockedAt  DateTime? // null = not yet uploaded; non-null = locked
  isSalarySlipEnabled   Boolean   @default(false) // employee self-service salary slip access

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  attendances       Attendance[]
  taskAssignments   TaskAssignment[]
  tasksCreated      Task[]            @relation("CreatedTasks")
  locationLogs      LocationLog[]
  visitReports      VisitReport[]
  projectsManaged   Project[]         @relation("ProjectManager")
  userProjects      UserProject[]
  leaves            Leave[]           @relation("UserLeaves")
  leavesApproved    Leave[]           @relation("ApprovedLeaves")
  notifications     Notification[]
  auditLogs         AuditLog[]
  leaveBalances  LeaveBalance[]
  geofenceAlerts GeofenceAlert[]
  travelLogs     TravelLog[]
  expenses         Expense[]  @relation("UserExpenses")
  expensesApproved Expense[]  @relation("ApprovedExpenses")
  payrollDeductions PayrollDeduction[]
  advances         Advance[]  @relation("UserAdvances")
  advancesApproved Advance[]  @relation("ApprovedAdvances")
  comments         Comment[]
  subscriptions    Subscription[]

  @@unique([organizationId, employeeId])
  @@index([organizationId])
}

model Shift {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name             String
  startTime        String       // Format "HH:MM", e.g. "09:00"
  endTime          String       // Format "HH:MM", e.g. "18:00"
  gracePeriod      Int          @default(15) // in minutes
  halfDayThreshold Float        @default(4.5) // in hours
  breakDuration    Int          @default(30) // in minutes
  color            String?      @default("#3b82f6")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  users            User[]
  
  @@index([organizationId])
}


model Territory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  polygon        Json?        // GeoJSON polygon coordinates
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  geofenceAlerts GeofenceAlert[]

  users          User[]
  tasks          Task[]

  @@index([organizationId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("CreatedTasks", fields: [createdById], references: [id])
  
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(PENDING)
  
  dueDate        DateTime?
  scheduledDate  DateTime?
  
  latitude       Float?
  longitude      Float?
  address        String?
  
  territoryId    String?
  territory      Territory?   @relation(fields: [territoryId], references: [id])
  
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  
  recurring      Boolean      @default(false)
  recurrenceRule String?      // cron format
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  assignments    TaskAssignment[]
  comments       Comment[]

  @@index([organizationId])
  @@index([createdById])
  @@index([territoryId])
  @@index([projectId])
}

model TaskAssignment {
  id               String           @id @default(cuid())
  taskId           String
  task             Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status           AssignmentStatus @default(ASSIGNED)
  assignedAt       DateTime         @default(now())
  acceptedAt       DateTime?
  completedAt      DateTime?
  
  completionNote   String?
  completionImages String[]         // URLs
  rating           Int?             // 1-5, nullable
  
  visitReports     VisitReport[]

  @@unique([taskId, userId])
  @@index([taskId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  
  @@index([taskId])
  @@index([userId])
}

model Attendance {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  date              DateTime         @db.Date // truncated to day
  
  sessionNumber     Int              @default(1)
  
  checkInTime       DateTime?
  checkOutTime      DateTime?
  
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  
  workingMinutes    Int?             // computed
  status            AttendanceStatus @default(PRESENT)
  isLate            Boolean          @default(false)
  isEarlyLogout     Boolean          @default(false)
  
  notes             String?
  selfieUrl         String?
  
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  
  @@unique([userId, date, sessionNumber])
  @@index([userId])
  @@index([date])
}

model LocationLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  latitude     Float
  longitude    Float
  accuracy     Float
  speed        Float?   // m/s
  heading      Float?
  altitude     Float?
  batteryLevel Float?
  isMoving     Boolean  @default(true)
  recordedAt   DateTime
  
  @@index([userId, recordedAt])
}

model VisitReport {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskAssignmentId String?
  taskAssignment   TaskAssignment? @relation(fields: [taskAssignmentId], references: [id])
  
  customerName     String
  customerPhone    String?
  customerAddress  String?
  
  visitType        VisitType       @default(OTHER)
  visitStatus      VisitStatus     @default(COMPLETED)
  
  latitude         Float?
  longitude        Float?
  notes            String?
  feedback         String?
  
  images           String[]        // Cloudinary URLs
  signatureUrl     String?         // Cloudinary URL
  
  checkInTime      DateTime?
  checkOutTime     DateTime?
  nextFollowUpDate DateTime?
  
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([taskAssignmentId])
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  
  startDate      DateTime?
  endDate        DateTime?
  status         ProjectStatus @default(ACTIVE)
  
  managerId      String
  manager        User          @relation("ProjectManager", fields: [managerId], references: [id])
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  tasks          Task[]
  members        UserProject[]

  @@index([organizationId])
  @@index([managerId])
}

model UserProject {
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@id([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Leave {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)
  
  type         LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  totalDays    Float
  
  reason       String?
  attachmentUrl String?
  status       LeaveStatus @default(PENDING)
  
  approvedById String?
  approvedBy   User?       @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  approvalNote String?
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([approvedById])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  
  type        NotificationType @default(SYSTEM)
  referenceId String?          // polymorphic reference
  isRead      Boolean          @default(false)
  
  createdAt   DateTime         @default(now())

  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  resource    String
  resourceId  String
  
  oldValues   Json?
  newValues   Json?
  
  ipAddress   String?
  userAgent   String?
  
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
}

model LeaveBalance {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           LeaveType
  year           Int
  allocated      Float     @default(0)
  used           Float     @default(0)

  @@unique([userId, type, year])
  @@index([userId])
}

model GeofenceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  territoryId String
  territory   Territory @relation(fields: [territoryId], references: [id])
  latitude    Float
  longitude   Float
  alertedAt   DateTime  @default(now())
  resolved    Boolean   @default(false)

  @@index([userId])
  @@index([territoryId])
}

model TravelLog {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @db.Date
  totalDistanceKm Float    @default(0)
  pathGeoJson     Json?
  attendanceId    String?  @unique

  // Meter Reading fields (employee-entered)
  meterStart      Float?   // odometer reading at start of day (KM)
  meterEnd        Float?   // odometer reading at end of day (KM)
  proofImageUrl   String?  // Cloudinary URL of meter photo
  allowanceAmount Float?   // computed = totalDistanceKm × travelAllowanceRate
  notes           String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
}

model Expense {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation("UserExpenses", fields: [userId], references: [id], onDelete: Cascade)
  category     ExpenseCategory
  amount       Float
  description  String?
  receiptUrl   String?
  date         DateTime        @db.Date
  status       ExpenseStatus   @default(DRAFT)
  approvedById String?
  approvalNote String?
  approvedBy   User?           @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  taskId       String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId])
  @@index([approvedById])
}

enum FeedbackCategory {
  WORK_ENVIRONMENT
  MANAGEMENT
  TOOLS_AND_EQUIPMENT
  COMPENSATION
  OTHER
}

model EmployeeFeedback {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       FeedbackCategory @default(OTHER)
  content        String
  rating         Int?             // 1-5 optional
  createdAt      DateTime         @default(now())

  // Note: NO userId relation intentionally for TRUE anonymity
  @@index([organizationId])
}

model PayrollDeduction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   @default("LATE_ARRIVAL_STREAK")
  amountDays  Float    @default(0) // How many days of salary to deduct
  reason      String
  dateApplied DateTime @default(now())
  
  @@index([userId])
}

model Advance {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation("UserAdvances", fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  reason         String?
  status         String          @default("PENDING") // PENDING, APPROVED, REJECTED
  dateRequested  DateTime        @default(now())
  dateApproved   DateTime?
  approvedById   String?
  approvedBy     User?           @relation("ApprovedAdvances", fields: [approvedById], references: [id])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
  @@index([approvedById])
}

model Subscription {
  id                String   @id @default(cuid())
  userId            String
  plan              String   // "FREE" | "BASIC" | "PRO"
  status            String   // "ACTIVE" | "EXPIRED" | "PENDING"
  razorpayOrderId   String?
  razorpayPaymentId String?
  startsAt          DateTime
  expiresAt         DateTime
  employeeCount     Int      @default(1)
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
}